# MongoDB Connection String (e.g. MongoDB Atlas or local mongodb://localhost:27017/evenza)
MONGO_URI=mongodb://localhost:27017/evenza

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=5000

# Brevo Transactional Email Service Configuration
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=notifications@evenza.com
BREVO_SENDER_NAME=Evenza
