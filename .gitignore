# ==============================================================================
# Evenza - Root .gitignore (MERN Monorepo)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Integrity Caches
# ------------------------------------------------------------------------------
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.js
.npm/
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnpm-store/

# ------------------------------------------------------------------------------
# 2. Environment Variables, Secrets & Credentials (NEVER SHARE PUBLICLY)
# ------------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*
backend/.env.local
backend/.env.*.local
frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.*.local

# API Client Local Environments (May contain dynamic auth tokens/bearer keys)
*.postman_environment.json
*.postman_globals.json
.insomnia/
.http-client/
rest-client.env.json

# Private Keys, Certificates & Cloud Credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pkcs12
*.keystore
id_rsa
id_rsa.pub
id_ed25519
credentials.json
service-account*.json
client_secret*.json
google-services.json
firebase-adminsdk*.json

# Always preserve safe public example environment templates
!.env.example
!backend/.env.example
!frontend/.env.example

# ------------------------------------------------------------------------------
# 3. Local Databases, Dumps & Upload Storage
# ------------------------------------------------------------------------------
data/
db/
*.sqlite
*.sqlite3
*.db
dump/
mongodump/
*.bson
*.dump
uploads/
storage/
temp_uploads/
media_uploads/

# Local runtime generated data exports (e.g. CSV guestlist downloads)
*Guestlist_*.csv
*Attendee_*.csv
export*.csv
*.export.*

# ------------------------------------------------------------------------------
# 4. Production Build Outputs & Bundles
# ------------------------------------------------------------------------------
dist/
dist-ssr/
frontend/dist/
build/
out/
.next/
*.local

# ------------------------------------------------------------------------------
# 5. Logs, Diagnostics & Crash Dumps
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
core
core.*
*.core
*.dmp
hs_err_pid*.log

# ------------------------------------------------------------------------------
# 6. Temporary Files, Caches & Scratchpads
# ------------------------------------------------------------------------------
temp/
tmp/
scratch/
.scratch/
*.scratch.*
scratch.*
local_notes.*
notes.local.*
*.bak
*.backup
*.old
*.orig
*~
*.sw?
*.tmp
*.temp
.cache/
.parcel-cache/
.vite/
.eslintcache
.stylelintcache
coverage/
.nyc_output/

# ------------------------------------------------------------------------------
# 7. Editor, IDE & AI Workspace Settings (Local-Only)
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.vscode/.history/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sublime-workspace
*.sublime-project
.cursor/
.windsurf/

# ------------------------------------------------------------------------------
# 8. Operating System Metadata Files
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/